# Copier en .env et remplir. Ne jamais committer .env.
# Le topic ntfy n'est PAS ici : il vit dans config.yml (lui aussi gitignored).

# ── Duffel API (https://app.duffel.com — Access Tokens, token live Read+Write)
#
# ATTENTION, c'est facturable : au-delà d'un ratio de 1 500 recherches par
# réservation, Duffel facture 0,005 $ par recherche supplémentaire
# (« excess search »). Un compte qui ne réserve jamais dépasse ce ratio.
# Laisser la variable vide (ou la ligne commentée) désactive proprement Duffel :
# le code renvoie une liste vide et fli reste la seule source de vols.
DUFFEL_API_KEY=

# ── Air France-KLM Open Data (https://developer.airfranceklm.com)
#
# Clé gratuite en self-service, utilisée par les « sondes compagnies »
# (section probes de config.yml). Gratuite, mais TRÈS contrainte :
#   • 100 requêtes par jour pour la clé ENTIÈRE — mesuré : les hosts AF et
#     KL partagent le même seau, une sonde KLM mange le quota de la sonde AF ;
#   • 1 requête par seconde ;
#   • aucun en-tête de quota renvoyé : le comptage est à notre charge, et
#     même une erreur 400 de validation consomme un jeton.
# Vide = les sondes se court-circuitent proprement, comme Duffel sans clé.
AFKL_API_KEY=

# ── ntfy : uniquement si le topic est protégé en écriture (topic réservé /
#    serveur self-hosté). Ne protège que l'émission, jamais la lecture.
NTFY_TOKEN=

# ── Optionnel : réactive /docs, /redoc et /openapi.json, désactivés par défaut
#    parce qu'il n'y a aucune authentification devant l'API.
# DEBUG=1

# ── Optionnel : chemins hors Docker (défaut /app/config.yml et data/config.yml.bak).
#    Note : le chemin de la base SQLite, lui, est codé en dur dans app/db.py.
# BKK_CONFIG=/app/config.yml
# BKK_CONFIG_BAK=/app/data/config.yml.bak

# Mot de passe des routes d administration du dashboard
# (page Admin et bouton Check). Vide = pas de protection.
ADMIN_PASSWORD=
